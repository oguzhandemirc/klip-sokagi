# Bu dosyayı .env olarak kopyala, değerleri sen doldur. .env paylaşılmaz, commit edilmez.
ANTHROPIC_API_KEY=
# İsteğe bağlı: Twitch kliplerinin yayındaki saniyesi için (dev.twitch.tv)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube Data API OAuth dosyasının yolu (Google Cloud Console'dan indirilir)
YT_CLIENT_SECRET_PATH=./client_secret.json
